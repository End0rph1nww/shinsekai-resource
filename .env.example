DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/shinsekai
SECRET_KEY=change-me-to-a-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 上游代理配置（服务端专用，绝不暴露给用户）
UPSTREAM_BASE_URL=https://api.minimaxi.com/v1
UPSTREAM_API_KEY=your-real-minimax-api-key-here
UPSTREAM_GROUP_ID=
PROXY_TIMEOUT=60

# 我们签发给用户的 API Key 前缀
API_KEY_PREFIX=sk-sn-

# 管理后台登录 Token
ADMIN_TOKEN=change-me-admin-token

# Stripe 支付（可选，不配置则充值功能不可用）
# 从 https://dashboard.stripe.com/apikeys 获取
STRIPE_SECRET_KEY=sk_test_...
# 从 Stripe Dashboard → Webhooks → Signing secret 获取
STRIPE_WEBHOOK_SECRET=whsec_...
# 本站的外部访问地址（用于 Stripe return_url）
SITE_URL=http://localhost:8765
